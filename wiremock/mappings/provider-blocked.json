{
  "name": "acc-blocked -> rejected with ACCOUNT_BLOCKED",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/provider/v1/execute",
    "bodyPatterns": [
      { "equalToJson": "{ \"accountId\": \"acc-blocked\" }", "ignoreExtraElements": true }
    ]
  },
  "response": {
    "status": 403,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "status": "REJECTED",
      "code": "ACCOUNT_BLOCKED",
      "message": "The account is blocked and cannot operate"
    }
  }
}
