{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/provider/v1/execute",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.type == 'DEBIT' && @.amount > 1000)]"
      }
    ]
  },
  "response": {
    "status": 422,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "status": "REJECTED",
      "code": "INSUFFICIENT_FUNDS",
      "message": "The account does not have enough balance to complete the transaction"
    }
  }
}